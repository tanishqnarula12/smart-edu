# ─────────────────────────────────────────────────────────────
# SMART EDU — Environment Configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.
# ─────────────────────────────────────────────────────────────

# ---------- Server ----------
NODE_ENV=development
PORT=5000

# ---------- Database (PostgreSQL) ----------
# Full connection string (takes precedence when set)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_edu

# Discrete parts — used only when DATABASE_URL is empty
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=smart_edu
# Set to "true" for hosted Postgres that requires TLS (Neon, Supabase, RDS...)
PGSSL=false

# ---------- Authentication ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ---------- Client ----------
CLIENT_URL=http://localhost:5173

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=25

# ---------- AI ----------
# mock | openai | anthropic
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# ---------- RAG / Vector store ----------
# mock | postgres | chroma | pinecone | faiss
VECTOR_PROVIDER=mock
VECTOR_API_KEY=
VECTOR_INDEX=smart-edu
VECTOR_URL=

# ---------- Payments (Razorpay) ----------
# Leave empty to run in mock payment mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------- File storage ----------
# local | s3
STORAGE_DRIVER=local
STORAGE_DIR=uploads
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=

# ---------- Demo seed ----------
# Password given to every seeded demo account (LOCAL DEVELOPMENT ONLY)
SEED_DEMO_PASSWORD=Demo@12345

# ---------- Academic policy ----------
ATTENDANCE_WARNING_THRESHOLD=75
